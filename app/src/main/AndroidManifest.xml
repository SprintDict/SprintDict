<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="net.bancer.sparkdict.permission.READ_SUGGESTIONS"
        android:protectionLevel="signature" />

    <uses-permission android:name="net.bancer.sparkdict.permission.READ_SUGGESTIONS" />

    <application
        android:name=".SparkDictApplication"
        android:icon="@drawable/ic_launcher_sparkdict"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".SparkDictActivity"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>


            <!-- Start system text selection config -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- End system text selection config -->


            <!-- Start share intent config -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- End share intent config -->


            <!-- Start searchable config -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
            <!-- End searchable config -->


            <!-- Start search dialog config -->
            <meta-data
                android:name="android.app.default_searchable"
                android:value=".SparkDictActivity" />
            <!-- End search dialog config -->


            <!-- Start link clicked in article config -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="net.bancer.sparkdict" />
            </intent-filter>
            <!-- End link clicked in article config -->

        </activity>
        <activity
            android:name=".DictManagerActivity"
            android:label="@string/manage_dictionaries" />
        <activity
            android:name=".DictPreferencesActivity"
            android:label="@string/activity_settings"
            android:theme="@style/DictPreferencesTheme" />

        <activity
            android:name="net.bancer.sparkdict.RecentHistoryActivity"
            android:label="@string/title_activity_recent_history">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="net.bancer.sparkdict.SparkDictActivity" />
        </activity>

        <provider
            android:name=".providers.SuggestionsProvider"
            android:authorities="net.bancer.sparkdict.providers.SuggestionsProvider"
            android:enabled="true"
            android:exported="true"
            android:readPermission="net.bancer.sparkdict.permission.READ_SUGGESTIONS">
            <path-permission
                android:pathPrefix="/search_suggest_query"
                android:readPermission="android.permission.GLOBAL_SEARCH" />
        </provider>

        <uses-library
            android:name="android.test.runner"
            android:required="false" />
        <uses-library
            android:name="android.test.base"
            android:required="false" />
    </application>

</manifest>