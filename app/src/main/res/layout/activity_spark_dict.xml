<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spark_dict_activity_top_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/black"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/navigation_bar_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp">

        <ImageButton
            android:id="@+id/nav_previous_btn"
            style="?android:attr/buttonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/nav_previous"
            android:enabled="false"
            android:src="@drawable/ic_nav_previous" />

        <ImageButton
            android:id="@+id/nav_next_btn"
            style="?android:attr/buttonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/nav_next"
            android:enabled="false"
            android:src="@drawable/ic_nav_next" />

        <ImageButton
            android:id="@+id/nav_history_btn"
            style="?android:attr/buttonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/nav_history"
            android:src="@drawable/ic_nav_history" />

        <ImageButton
            android:id="@+id/nav_expand_all_btn"
            style="?android:attr/buttonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/menu_expand_all"
            android:src="@drawable/ic_nav_expand_all" />

        <ImageButton
            android:id="@+id/nav_collapse_all_btn"
            style="?android:attr/buttonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/menu_collapse_all"
            android:src="@drawable/ic_nav_collapse_all" />

        <ImageButton
            android:id="@+id/nav_find_on_page_btn"
            style="?android:attr/buttonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/menu_find_on_page"
            android:src="@drawable/ic_nav_find_on_page" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/navigation_bar_layout"
        android:orientation="horizontal">

        <net.bancer.sparkdict.views.SearchInputField
            android:id="@+id/searchTextView"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:inputType="text|textAutoComplete">

            <requestFocus android:id="@+id/focus_requester" />
        </net.bancer.sparkdict.views.SearchInputField>

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/search"
            android:padding="10dp"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/find_on_page_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:baselineAligned="true"
        android:fadingEdge="horizontal"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/find_on_page_edit_text"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:autofillHints="none"
            android:hint="@string/find_on_page_hint"
            android:inputType="text" />

        <Button
            android:id="@+id/find_on_page_next_btn"
            android:layout_width="60dp"
            android:layout_height="60dp"
            xmlns:tools="http://schemas.android.com/tools"
            tools:ignore="HardcodedText"
            android:contentDescription="@string/find_on_page_next"
            android:onClick="onFindNextWordOnPageButtonClick"
            android:text="&#x25BC;"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <Button
            android:id="@+id/find_on_page_previous_btn"
            android:layout_width="60dp"
            android:layout_height="60dp"
            xmlns:tools="http://schemas.android.com/tools"
            tools:ignore="HardcodedText"
            android:contentDescription="@string/find_on_page_previous"
            android:onClick="onFindPreviousWordOnPageButtonClick"
            android:text="&#x25B2;"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <Button
            android:id="@+id/find_on_page_close_btn"
            android:layout_width="60dp"
            android:layout_height="60dp"
            xmlns:tools="http://schemas.android.com/tools"
            tools:ignore="HardcodedText"
            android:contentDescription="@string/find_on_page_close"
            android:onClick="onCloseFindOnPageBarButtonClick"
            android:text="&#x2715;"
            android:textAppearance="?android:attr/textAppearanceLarge" />
    </LinearLayout>

    <net.bancer.sparkdict.views.LockableScrollView
        android:id="@+id/articles_scroll_view"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/find_on_page_layout"
        android:layout_below="@id/search_layout">

        <net.bancer.sparkdict.views.LexicalEntriesListView
            android:id="@+id/articles_list"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </net.bancer.sparkdict.views.LockableScrollView>

    <ProgressBar
        android:id="@+id/search_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/find_on_page_layout"
        android:layout_below="@id/search_layout"
        android:layout_centerHorizontal="true"
        android:visibility="gone" />

</RelativeLayout>